      "level": "basic",
      "title": "周末聊什么",
      "role": "Mia",
      "role_zh": "Mia · 同事",
      "persona": "Mia, a friendly coworker, chatting with you on Monday morning",
      "opening": "Morning! How was your weekend?",
      "opening_zh": "早！周末过得怎么样？",
      "brief": "周一早上，同事 Mia 问你周末过得怎么样。",
      "tasks": [
        {
          "zh": "说你周末做了什么",
          "check": "the learner says what they did on the weekend"
        },
        {
          "zh": "说说感觉怎么样",
          "check": "the learner says how it felt"
        },
        {
          "zh": "问她周末怎么样",
          "check": "the learner asks about Mia's weekend",
          "match": [
            "(how was|what did you do|how about|what about) (your|you on the|the) weekend",
            "did you (do|go) .*weekend",
            "how about you|what about you|and you\\b"
          ]
        },
        {
          "zh": "对她说的内容表示感兴趣或惊讶",
          "check": "the learner reacts to what Mia said with interest or surprise"
